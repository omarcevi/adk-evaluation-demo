# Copy to shop_helper/.env and fill in. Never commit the real .env.
GOOGLE_GENAI_USE_ENTERPRISE=TRUE
GOOGLE_CLOUD_PROJECT=your-project-id
# Gemini 3 models and the eval judges use the global endpoint.
GOOGLE_CLOUD_LOCATION=global
# Region where Agent Runtime hosts the deployed agent.
AGENT_RUNTIME_REGION=us-central1

# Show tool arguments/results in Cloud Trace spans (demo data only, no PII).
ADK_CAPTURE_MESSAGE_CONTENT_IN_SPANS=true

# After the first `make deploy`, uncomment and set this to the number at the end
# of the printed resource name (.../reasoningEngines/<AGENT_ENGINE_ID>).
# AGENT_ENGINE_ID=
